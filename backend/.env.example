# Environment variables for ShopKart Clone Backend
# Copy this to .env and fill in the real values

PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/shopkart
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=1d

# Razorpay credentials — get them at https://dashboard.razorpay.com/
# Under Settings > API Keys, generate a Test key pair
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
